# =============================================================================
# Restaurant QR OS — environment
#
# Copy to `.env.local` and fill in. Every variable below is validated at startup
# by src/lib/env.ts, which fails fast with a readable message rather than
# letting the app boot into a half-configured state.
#
# With NO Supabase variables set the app boots in DEMO MODE: it serves the
# in-repo fixture restaurant so the product can be explored end to end without
# a database. Demo mode is labelled in the UI and never presents fixture
# numbers as real analytics.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key. Safe to ship to the browser: the `anon` role holds no
# table privileges at all and may execute exactly five capability functions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY. Never referenced from a Client Component, never
# prefixed NEXT_PUBLIC_. Modules that read it start with `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application --------------------------------------------------------------
# Absolute origin used to build QR code URLs (https://<origin>/t/<token>).
# Must be the origin diners actually reach, not localhost, in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale when a request carries no cookie and no usable Accept-Language.
# One of: uz | ru | en
NEXT_PUBLIC_DEFAULT_LOCALE=uz
